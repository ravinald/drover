<!DOCTYPE html>
<!-- drover builtin:html. Copy it with `drover status --print-template builtin:html`. -->
{{- /* status --all-projects hands this template {projects, now} and status hands it one project's report: .projects is present only in the first. */}}
{{- $index := ne (printf "%T" .projects) "<nil>"}}
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
{{- if .refresh}}
<meta http-equiv="refresh" content="{{.refresh}}" />
{{- end}}
<title>{{if $index}}drover projects{{else}}{{.project}}: drover status{{end}}</title>
<style>
:root {
  --bg: #ffffff; --fg: #1f2328; --muted: #59636e; --line: #d1d9e0;
  --green: #1a7f37; --yellow: #9a6700; --orange: #bc4c00; --red: #cf222e; --link: #0969da;
  --stripe: #f6f8fa; --hover: #eaeef2;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117; --fg: #e6edf3; --muted: #9198a1; --line: #3d444d;
    --green: #3fb950; --yellow: #d29922; --orange: #f0883e; --red: #f85149; --link: #4493f8;
    --stripe: #151b23; --hover: #262c36;
  }
}
* { box-sizing: border-box; }
body { margin: 0 auto; max-width: 60rem; padding: 1rem; background: var(--bg); color: var(--fg);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
a { color: var(--link); }
h1 { font-size: 1.5rem; margin: 0 0 1rem; }
h2 { font-size: 1.2rem; margin: 0; display: inline; }
.contents a { white-space: nowrap; }
details.section { margin: 1.5rem 0 0; }
details.section > summary { cursor: pointer; padding: 0.25rem 0; }
details.section > .body { margin-top: 0.25rem; padding: 0.25rem 0.75rem 0.5rem; background: var(--stripe); border: 1px solid var(--line); border-radius: 0.4rem; }
details.attention > .body { border-color: var(--red); }
h3 { font-size: 1.05rem; margin: 1rem 0 0.25rem; }
h4 { font-size: 0.95rem; margin: 0.75rem 0 0.25rem; }
code { font-size: 0.9em; }
.id { font-weight: 700; font-family: ui-monospace, monospace; }
.meta { color: var(--muted); font-size: 0.9em; }
.empty { color: var(--muted); }
footer { margin-top: 2rem; color: var(--muted); font-size: 0.85em; }
.state { font-weight: 600; padding: 0 0.3em; border: 1px solid currentColor; border-radius: 0.3em; white-space: nowrap; }
.drover-done, .drover-ready { color: var(--green); }
.drover-running, .drover-pausing { color: var(--yellow); }
.drover-paused { color: var(--muted); }
.drover-blocked, .drover-scaffold, .drover-unaudited { color: var(--orange); }
.drover-parked, .drover-broken, .drover-needs-operator { color: var(--red); }
.drover-warning { color: var(--orange); }
.drover-critical { color: var(--red); }
table { border-collapse: collapse; width: 100%; }
th, td { text-align: left; padding: 0.3rem 0.5rem 0.3rem 0; border-bottom: 1px solid var(--line); vertical-align: middle; }
th { font-weight: 600; }
.scroll { overflow: auto; max-height: 80vh; margin-bottom: 0.5rem; }
.items td { white-space: nowrap; }
.items td.title, .items td.reason { white-space: normal; overflow-wrap: anywhere; min-width: 12rem; }
.items thead th { position: sticky; top: 0; background: var(--stripe); white-space: nowrap; }
.items tbody tr:nth-child(even) { background: var(--bg); }
.items tbody tr:hover { background: var(--hover); }
.items tr:target { outline: 2px solid var(--link); outline-offset: -2px; }
.key td { padding: 0.2rem 0.5rem 0.2rem 0; }
.key td:first-child { white-space: nowrap; }
.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
.spark { display: block; fill: none; stroke: var(--link); stroke-width: 1.5; }
.spark circle { fill: var(--link); stroke: none; }
</style>
</head>
<body>
{{- if $index}}
<h1>drover projects</h1>
{{- with .projects}}
<table>
<tr><th>Project</th><th>Drive</th><th>Item</th><th>Queue</th><th>Needs you</th><th>Finished</th><th>Last finished</th></tr>
{{- range .}}
{{- $link := ""}}{{range .renders}}{{if and (not $link) (eq .format "html")}}{{$link = .href}}{{end}}{{end}}
<tr><td>{{if $link}}<a class="id" href="{{$link}}">{{.project}}</a>{{else}}<span class="id">{{.project}}</span>{{end}}</td>
{{- if .error}}<td colspan="6"><span class="state drover-broken">unreadable</span> {{.error}}</td>
{{- else}}<td>{{with .drive}}{{.}}{{else}}-{{end}}{{with .label}} · {{.}}{{end}}{{if .paused}} · paused{{end}}</td><td>{{range $i, $r := .running}}{{if $i}}, {{end}}{{$r}}{{else}}-{{end}}</td><td class="num">{{with .queue}}{{.}}{{else}}-{{end}}</td><td class="num">{{with .attention}}{{.}}{{else}}-{{end}}</td><td class="num">{{with .finished}}{{.value}}{{else}}n/a{{end}}</td><td class="num">{{with .last_finished}}{{time "2006-01-02 15:04" .}}{{else}}-{{end}}</td>
{{- end}}</tr>
{{- range .worktrees}}
<tr><td colspan="7" class="meta">worktree {{.}}</td></tr>
{{- end}}
{{- end}}
</table>
{{- else}}
<p class="empty">No projects are registered.</p>
{{- end}}
<footer>Rendered {{time "2006-01-02 15:04 MST" .now}}</footer>
{{- else}}
<h1>{{with .index}}<a href="{{.}}">drover</a> / {{end}}{{.project}}</h1>
<nav id="contents" class="meta contents" data-project="{{.project}}"><a href="#needs-you">Needs you ({{with .attention}}{{len .}}{{else}}0{{end}})</a> · <a href="#running-drive">Running drive</a> · <a href="#open">Open ({{len (open .items)}})</a> · <a href="#done">Done ({{len (done .items)}})</a> · <a href="#trends">Trends</a> · <a href="#key">Key</a></nav>

<details open="" id="needs-you" class="section{{if .attention}} attention{{end}}"><summary><h2>Needs you</h2></summary><div class="body">
{{- with .attention}}
<div class="scroll"><table class="items">
<thead><tr><th>State</th><th>Item</th><th>Reason</th><th>Since</th><th>Command</th></tr></thead>
<tbody>
{{- range .}}
<tr>{{if eq .kind "follow-up"}}<td><span class="state">follow-up</span></td><td>{{with .id}}{{$u := issue .}}{{if $u}}<a href="{{$u}}">#{{.}}</a>{{else}}#{{.}}{{end}}{{else}}-{{end}}</td>{{else}}<td><span class="state drover-{{class .kind}}">{{class .kind}}</span></td><td>{{with .id}}<a class="id" href="#item-{{anchor .}}">{{.}}</a>{{else}}-{{end}}</td>{{end}}<td class="reason">{{or .reason "-"}}</td><td class="num">{{with .since}}{{ago .}}{{else}}-{{end}}</td><td>{{with .command}}<code>{{.}}</code>{{else}}-{{end}}</td></tr>
{{- end}}
</tbody>
</table></div>
{{- else}}{{if not .long_sessions}}
<p class="empty">Nothing is waiting on you.</p>
{{- end}}{{end}}
{{- with .long_sessions}}
<h3>Long sessions</h3>
<p class="meta">Sessions read from the ledger, which records one when it exits or when its day ends, so a session running now shows up only after that. Live work is under Running drive.</p>
<div class="scroll"><table class="items">
<thead><tr><th>Session</th><th>Item</th><th>Source</th><th>State</th><th>Tokens</th><th>Reason</th></tr></thead>
<tbody>
{{- range .}}
<tr><td><code>{{.session_id}}</code></td><td>{{with .id}}<a class="id" href="#item-{{anchor .}}">{{.}}</a>{{else}}-{{end}}</td><td>{{.source}}</td><td>{{if eq .state "ended"}}ended{{else}}last seen {{ago .last_seen}}{{end}}</td><td class="num">{{tokens .weighted}}</td><td class="reason">{{.reason}}</td></tr>
{{- end}}
</tbody>
</table></div>
{{- end}}
</div></details>

<details open="" id="running-drive" class="section"><summary><h2>Running drive</h2></summary><div class="body">
{{- $running := false}}
{{- range .drives}}{{if .running}}{{$running = true}}
<p><span class="id">{{.id}}</span>{{with .label}} · {{.}}{{end}}{{if .paused}}{{with pausing $.lease}} · <span class="state drover-pausing">pausing</span> <span class="meta">{{.}} still finishing a stage</span>{{else}} · <span class="state drover-paused">paused</span>{{end}}{{end}} <span class="meta">started {{ago .started}}{{with .jobs}} · {{.}} at a time{{end}}</span></p>
<div class="scroll"><table class="items">
<thead><tr><th>Item</th><th>Title</th><th>Stage</th><th>Elapsed</th><th>ETA</th></tr></thead>
<tbody>
{{- with $.lease}}{{range .running}}{{$id := .}}{{range $.items}}{{if eq .id $id}}
{{- $h := held $.lease .id}}
<tr><td>{{if $h}}<span class="state drover-paused">paused</span>{{else if $.lease.paused}}<span class="state drover-pausing">pausing</span>{{else}}<span class="state drover-running">running</span>{{end}} <a class="id" href="#item-{{anchor .id}}">{{.id}}</a></td><td class="title">{{or .title "-"}}</td><td>{{if $h}}held before {{$h}}{{else}}{{or .stage "-"}}{{end}}</td><td class="num">{{with .stage_started}}{{dur . $.now}}{{else}}-{{end}}</td><td class="num">{{if $h}}-{{else}}{{with .eta}}{{time "15:04 MST" .}} ({{ago .}}){{else}}-{{end}}{{end}}</td></tr>
{{- end}}{{end}}{{end}}{{end}}
</tbody>
</table></div>
{{- with $.lease}}{{with .queue}}
<p class="meta">queued: {{range $i, $q := .}}{{if $i}}, {{end}}<a href="#item-{{anchor $q}}">{{$q}}</a>{{end}}</p>
{{- end}}{{end}}
{{- end}}{{end}}
{{- if not $running}}
<p class="empty">No drive is running.</p>
{{- end}}
</div></details>

<details open="" id="open" class="section"><summary><h2>Open</h2></summary><div class="body">
{{- range groups .items .drives .lease}}
<h3>{{if .drive}}Drive {{.drive}}{{with .label}} · {{.}}{{end}}{{else}}No drive{{end}}</h3>
{{- range .states}}{{$st := .}}
<h4><span class="state drover-{{.class}}">{{.state}}</span></h4>
<div class="scroll"><table class="items">
<thead><tr><th>Item</th><th>Title</th><th>Severity</th><th>Stage or park</th><th>Deps</th><th>Blocks</th><th>PR</th><th>ETA</th><th>Tokens</th><th>List $</th></tr></thead>
<tbody>
{{- range .items}}
<tr id="item-{{anchor .id}}"><td><span class="state drover-{{$st.class}}">{{$st.state}}</span> {{$u := issue .issue}}{{if $u}}<a class="id" href="{{$u}}">{{.id}}</a>{{else}}<span class="id">{{.id}}</span>{{end}}</td><td class="title">{{or .title "-"}}</td><td>{{or .severity "-"}}</td>
{{- if or .park .detail}}<td class="reason">{{.park}}{{if and .park .detail}}: {{end}}{{.detail}}</td>
{{- else if .error}}<td class="reason">{{.error}}</td>
{{- else}}<td>{{or .stage "-"}}</td>{{end}}<td>{{range $i, $d := .deps}}{{if $i}}, {{end}}<a href="#item-{{anchor $d}}">{{$d}}</a>{{else}}-{{end}}</td><td>{{range $i, $b := .blocks}}{{if $i}}, {{end}}<a href="#item-{{anchor $b}}">{{$b}}</a>{{else}}-{{end}}</td><td class="num">{{with .pr}}{{$u := or .url (pr .number)}}{{with .number}}{{if $u}}<a href="{{$u}}">#{{.}}</a>{{else}}#{{.}}{{end}}{{else}}-{{end}}{{else}}-{{end}}</td><td class="num">{{with .eta}}{{time "15:04 MST" .}} ({{ago .}}){{else}}-{{end}}</td>{{template "spent" .}}</tr>
{{- end}}
</tbody>
</table></div>
{{- end}}
{{- else}}
<p class="empty">Nothing is open.</p>
{{- end}}
</div></details>

<details open="" id="done" class="section"><summary><h2>Done</h2></summary><div class="body">
{{- with done .items}}
<div class="scroll"><table class="items">
<thead><tr><th>Item</th><th>Title</th><th>Level</th><th>PR</th><th>Merged</th><th>Tokens</th><th>List $</th></tr></thead>
<tbody>
{{- range .}}
<tr id="item-{{anchor .id}}"><td>{{$u := issue .issue}}{{if $u}}<a class="id" href="{{$u}}">{{.id}}</a>{{else}}<span class="id">{{.id}}</span>{{end}}</td><td class="title">{{or .title "-"}}</td><td><span class="state drover-{{class (or .level "unaudited")}}">{{or .level "unaudited"}}</span></td><td class="num">{{with .pr}}{{$u := or .url (pr .number)}}{{with .number}}{{if $u}}<a href="{{$u}}">#{{.}}</a>{{else}}#{{.}}{{end}}{{else}}-{{end}}{{else}}-{{end}}</td><td class="num">{{with .finished}}{{time "2006-01-02" .}}{{else}}-{{end}}</td>{{template "spent" .}}</tr>
{{- end}}
</tbody>
</table></div>
{{- else}}
<p class="empty">Nothing has merged yet.</p>
{{- end}}
</div></details>

<details open="" id="trends" class="section"><summary><h2>Trends</h2></summary><div class="body">
{{- with .trends}}
<p class="meta">{{.from}} to {{.to}}, {{.window}} days. n is how many items each figure is read from; n/a is a period with nothing to read.</p>
<table>
<tr><th>Metric</th><th>Window</th><th>n</th><th>By day</th></tr>
{{- $d := .days}}
{{- with .total}}
<tr><td>Finished</td><td class="num">{{with .finished}}{{.value}}{{else}}n/a{{end}}</td><td class="num">{{with .finished}}{{.n}}{{end}}</td><td>{{spark $d "finished" "value"}}</td></tr>
<tr><td>Cycle time, median</td><td class="num">{{with .cycle_time}}{{secs .median}}{{else}}n/a{{end}}</td><td class="num">{{with .cycle_time}}{{.n}}{{end}}</td><td>{{spark $d "cycle_time" "median"}}</td></tr>
<tr><td>Cycle time, p90</td><td class="num">{{with .cycle_time}}{{secs .p90}}{{else}}n/a{{end}}</td><td class="num">{{with .cycle_time}}{{.n}}{{end}}</td><td>{{spark $d "cycle_time" "p90"}}</td></tr>
<tr><td>Review passes per item</td><td class="num">{{with .review_passes}}{{num .value}}{{else}}n/a{{end}}</td><td class="num">{{with .review_passes}}{{.n}}{{end}}</td><td>{{spark $d "review_passes" "value"}}</td></tr>
<tr><td>Changes-requested rate</td><td class="num">{{with .changes_rate}}{{pct .value}}{{else}}n/a{{end}}</td><td class="num">{{with .changes_rate}}{{.n}}{{end}}</td><td>{{spark $d "changes_rate" "value"}}</td></tr>
<tr><td>Parks{{with .parks}}{{range $reason, $n := .by_reason}} <span class="meta">{{$reason}} {{$n}}</span>{{end}}{{end}}</td><td class="num">{{with .parks}}{{.value}}{{else}}n/a{{end}}</td><td class="num">{{with .parks}}{{.n}}{{end}}</td><td>{{spark $d "parks" "value"}}</td></tr>
<tr><td>Review passed to merge, median</td><td class="num">{{with .review_to_merge}}{{secs .median}}{{else}}n/a{{end}}</td><td class="num">{{with .review_to_merge}}{{.n}}{{end}}</td><td>{{spark $d "review_to_merge" "median"}}</td></tr>
<tr><td>Verify, median</td><td class="num">{{with .verify}}{{secs .median}}{{else}}n/a{{end}}</td><td class="num">{{with .verify}}{{.n}}{{end}}</td><td>{{spark $d "verify" "median"}}</td></tr>
{{- end}}
</table>
{{- else}}
<p class="empty">No trends to read.</p>
{{- end}}
</div></details>

<details open="" id="key" class="section"><summary><h2>Key</h2></summary><div class="body">
<p class="meta">Red waits on a person, yellow is moving, gray is held by a paused drive, orange cannot move yet or is unproven, green is settled.</p>
<table class="key">
<tr><td><span class="state drover-needs-operator">needs-operator</span></td><td>Waiting on you. Needs you names the command.</td></tr>
<tr><td><span class="state drover-parked">parked</span></td><td>A drive stopped the item. Stage or park says why.</td></tr>
<tr><td><span class="state drover-broken">broken</span></td><td>The item's body does not parse.</td></tr>
<tr><td><span class="state drover-running">running</span></td><td>A session is working on it now.</td></tr>
<tr><td><span class="state drover-pausing">pausing</span></td><td>Its drive is paused and it is finishing the stage it is in. It holds once that stage ends.</td></tr>
<tr><td><span class="state drover-paused">paused</span></td><td>Held by a paused drive before its next stage. Nothing runs until <code>drover drive --resume</code>.</td></tr>
<tr><td><span class="state drover-running">implemented</span></td><td>Implemented, waiting on its review and pull request.</td></tr>
<tr><td><span class="state drover-ready">ready</span></td><td>Every dependency has merged and nothing has run.</td></tr>
<tr><td><span class="state drover-blocked">blocked</span></td><td>A dependency has not merged.</td></tr>
<tr><td><span class="state drover-scaffold">scaffold</span></td><td>Requirements not written. Write them, then <code>drover accept</code>.</td></tr>
<tr><td><span class="state drover-done">claimed</span> <span class="state drover-done">reviewed</span> <span class="state drover-done">verified</span></td><td>Merged, at the audit level recorded: the author's word, a read of the diff, every requirement traced.</td></tr>
<tr><td><span class="state drover-unaudited">unaudited</span></td><td>Merged, and nobody has audited it.</td></tr>
<tr><td><span class="state">follow-up</span></td><td>An open follow-up nothing is scheduled to carry.</td></tr>
</table>
</div></details>

<footer>
{{- with .usage}}
<p>Usage {{if eq .window "7d"}}over the last 7 days{{else}}since {{time "Mon 2006-01-02 15:04 MST" .window}}{{end}}: {{tokens .weighted}} weighted tokens, {{usd .cost_usd}} at list price{{with .budget_used}} · {{$c := budget .}}<span class="state{{with $c}} drover-{{.}}{{end}}">budget {{pct .}}</span> of {{tokens $.usage.budget}} across every project{{end}}{{with .budget_unread}} · not read: {{range $i, $p := .}}{{if $i}}; {{end}}{{$p}}{{end}}{{end}}</p>
{{- end}}
Rendered {{time "2006-01-02 15:04 MST" .now}} ({{.zone}}) · {{.project}} · drover {{.version}}</footer>
{{- /* Without storage or script every section stays open, as the markup has it. The script holds no < or & so the page still parses as XML. */}}
<script>
(function () {
  var sections = document.querySelectorAll("details.section");
  var key = "drover-sections:" + document.getElementById("contents").getAttribute("data-project");
  try {
    var saved = JSON.parse(localStorage.getItem(key));
    if (saved !== null) {
      sections.forEach(function (d) {
        if (typeof saved[d.id] === "boolean") d.open = saved[d.id];
      });
    }
  } catch (e) {}
  sections.forEach(function (d) {
    d.addEventListener("toggle", function () {
      var state = {};
      sections.forEach(function (s) { state[s.id] = s.open; });
      try { localStorage.setItem(key, JSON.stringify(state)); } catch (e) {}
    });
  });
  function reveal(id) {
    for (var el = document.getElementById(id); el; el = el.parentElement) {
      if (el.tagName === "DETAILS") el.open = true;
    }
  }
  document.addEventListener("click", function (e) {
    var a = e.target.closest("a[href^='#']");
    if (a) reveal(a.getAttribute("href").slice(1));
  });
  window.addEventListener("hashchange", function () { reveal(location.hash.slice(1)); });
})();
</script>
{{- end}}
</body>
</html>
{{- define "spent"}}<td class="num">{{with .usage}}{{tokens .weighted}}{{else}}-{{end}}</td><td class="num">{{with .usage}}{{usd .cost_usd}}{{else}}-{{end}}</td>{{end}}
